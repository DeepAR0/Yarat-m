{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "types": [
      "vite/client",
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "capacitor.config.ts",
    "server",
    "db",
    "drizzle.config.ts"
  ]
}
